# Baked into the production build (web + mobile). Public hostname, not a secret.
VITE_API_HOST=eventana-api.onrender.com

# NOTE: VITE_STAFF_TOKEN is intentionally NOT set here. It is a secret and must
# never be committed. On Render it is set as a service env var. For a mobile
# build it would be baked into the distributed binary — see MOBILE.md, "Security:
# the dashboard app". Do not ship the dashboard publicly with a shared token.
