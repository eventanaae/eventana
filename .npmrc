# Build tooling (typescript, @types/node, @types/pg, vite) lives in
# devDependencies. Render sets NODE_ENV=production on the API service, which
# would make `npm ci` omit devDependencies and break `tsc`/`vite build`.
# `include=dev` forces them to install regardless, so the build has its
# compilers. Runtime deps are unchanged; the start command runs compiled JS.
include=dev
