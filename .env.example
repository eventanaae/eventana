# Eventana engine — server environment.
#
# Copy to `.env` and fill in. NEVER commit the real file, never paste these
# values into a chat, a document or the mobile app. Anything that has been
# shared in a conversation must be treated as compromised and rotated.

# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eventana

# Public URLs used to build provider return + webhook URLs.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Staff access to /api/admin. Replace with real SSO before go-live.
STAFF_TOKEN=dev-staff-token

# ------------------------------------------------------------ payments
# Set EVENTANA_PAYMENT_MODE=live only after every sandbox test passes.
EVENTANA_PAYMENT_MODE=sandbox

# Tabby — from your Tabby merchant account.
#   TABBY_PUBLIC_KEY     low sensitivity, may ship in the client
#   TABBY_SECRET_KEY     CRITICAL — server only
#   TABBY_MERCHANT_CODE  medium
#   TABBY_WEBHOOK_SECRET CRITICAL — you choose this value, then register it
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TABBY_WEBHOOK_SECRET=

# Tamara
TAMARA_PUBLIC_KEY=
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=

# Ziina
ZIINA_API_KEY=
ZIINA_WEBHOOK_SECRET=

# A provider with missing secrets runs in SIMULATED mode: the whole engine
# works and is testable, but the app never takes real money. Production
# refuses to start while any provider is simulated.

# --------------------------------------------------------------- maps
# Server-side key for geocoding, routing and live ETA.
GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------- reconciliation
RECONCILE_INTERVAL_MS=300000
RECONCILE_STUCK_AFTER_MS=600000
RECONCILE_ALERT_AFTER_MS=1800000
