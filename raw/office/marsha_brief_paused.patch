+/**
+ * Marsha's morning brief — pure builder + email renderer (no database).
+ */
+import { describe, expect, it } from 'vitest';
+import { buildMarshaBrief, printKind, renderMarshaBriefHtml, type BriefReadiness, type BriefTask } from '../src/domain/marshaBriefCore.js';
+
+const base = { reference: 'EV-1001', babyName: 'Saif', theme: 'Mickey', celebration: 'Birthday' };
+const task = (o: Partial<BriefTask>): BriefTask => ({
+  eventId: 'e1', eventDate: '2026-11-30', key: 'design_plate_papers', title: 'Plate Papers (design)',
+  dueDate: '2026-11-26', status: 'not_started', ...base, ...o,
+});
+
+describe('printKind', () => {
+  it('labels print, cricut and other design work', () => {
+    expect(printKind('design_plate_papers')).toBe('print');
+    expect(printKind('design_giveaways')).toBe('print');
+    expect(printKind('design_cricut')).toBe('cricut');
+    expect(printKind('design_something_new')).toBe('design');
+  });
+});
+
+describe('buildMarshaBrief', () => {
+  const today = '2026-11-26';
+
+  it('puts only work due today, tomorrow or late on the print list', () => {
+    const b = buildMarshaBrief(today, [
+      task({ key: 'design_water_labels', dueDate: '2026-11-25' }),   // late
+      task({ key: 'design_plate_papers', dueDate: '2026-11-26' }),   // today
+      task({ key: 'design_cricut', dueDate: '2026-11-27' }),         // tomorrow
+      task({ key: 'design_giveaways', dueDate: '2026-11-28' }),      // later → cards only
+      task({ key: 'design_entrance_stand', dueDate: null }),         // no date → cards only
+    ], []);
+    expect(b.printList.map((t) => t.key)).toEqual(['design_water_labels', 'design_plate_papers', 'design_cricut']);
+    expect(b.printList[0].overdue).toBe(true);
+    expect(b.printList[1].overdue).toBe(false);
+    expect(b.designCards).toHaveLength(1);
+    expect(b.designCards[0].items).toHaveLength(5);
+    expect(b.isEmpty).toBe(false);
+  });
+
+  it('ignores completed tasks and groups cards per party in date order', () => {
+    const b = buildMarshaBrief(today, [
+      task({ eventId: 'e2', eventDate: '2026-12-02', reference: 'EV-1002' }),
+      task({ eventId: 'e1', eventDate: '2026-11-29' }),
+      task({ eventId: 'e1', status: 'completed', key: 'design_cricut' }),
+    ], []);
+    expect(b.designCards.map((c) => c.eventId)).toEqual(['e1', 'e2']);
+    expect(b.designCards[0].items).toHaveLength(1);
+  });
+
+  it('keeps only parties that still need something in readiness', () => {
+    const r = (o: Partial<BriefReadiness>): BriefReadiness => ({
+      eventId: 'e1', reference: 'EV-1001', eventDate: '2026-11-27', babyName: 'Saif', theme: 'Mickey',
+      openPrep: 0, unassignedPrep: 0, openCrew: 0, ...o,
+    });
+    const b = buildMarshaBrief(today, [], [r({}), r({ eventId: 'e3', openCrew: 1 }), r({ eventId: 'e4', openPrep: 2, unassignedPrep: 1 })]);
+    expect(b.readiness.map((x) => x.eventId)).toEqual(['e3', 'e4']);
+  });
+
+  it('is empty when there is nothing to report', () => {
+    expect(buildMarshaBrief(today, [], []).isEmpty).toBe(true);
+  });
+});
+
+describe('renderMarshaBriefHtml', () => {
+  it('renders the three sections and escapes names', () => {
+    const b = buildMarshaBrief('2026-11-26', [task({ babyName: '<b>Saif</b>' })], []);
+    const html = renderMarshaBriefHtml(b);
+    expect(html).toContain('Print &amp; cut list');
+    expect(html).toContain('Design cards');
+    expect(html).toContain('Party readiness');
+    expect(html).toContain('&lt;b&gt;Saif&lt;/b&gt;');
+    expect(html).not.toContain('<b>Saif</b>');
+  });
+});
