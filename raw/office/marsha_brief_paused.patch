+/**
+ * Marsha's morning brief — pure part (no database, no network).
+ *
+ * Owner-approved (26 Nov 2026): three helpers for Marsha, delivered as ONE
+ * English email each morning:
+ *   1. Print list  — design/print work due today or tomorrow (or overdue).
+ *   2. Design cards — every party in the next 7 days that still has design work,
+ *      with the name / theme / occasion she designs from.
+ *   3. Readiness   — parties in the next 2 days with open prep, prep nobody is
+ *      assigned to, or crew slots still empty.
+ * Everything here only READS what the prep engine already created; it never
+ * changes a task and never contacts a customer or a supplier.
+ */
+
+export interface BriefTask {
+  eventId: string;
+  reference: string;
+  eventDate: string;          // YYYY-MM-DD
+  babyName: string | null;
+  theme: string | null;
+  celebration: string | null;
+  key: string;                // prep template key, e.g. design_plate_papers
+  title: string;
+  dueDate: string | null;     // YYYY-MM-DD
+  status: string;
+}
+
+export interface BriefReadiness {
+  eventId: string;
+  reference: string;
+  eventDate: string;
+  babyName: string | null;
+  theme: string | null;
+  openPrep: number;
+  unassignedPrep: number;
+  openCrew: number;
+}
+
+export type PrintKind = 'print' | 'cricut' | 'design';
+
+/** Which kind of work a design task is (so the list says "print" vs "cut"). */
+export function printKind(key: string): PrintKind {
+  if (key === 'design_cricut') return 'cricut';
+  if (['design_plate_papers', 'design_water_labels', 'design_entrance_stand', 'design_giveaways', 'design_new_backdrop'].includes(key)) return 'print';
+  return 'design';
+}
+
+export interface DesignCard {
+  eventId: string;
+  reference: string;
+  eventDate: string;
+  babyName: string | null;
+  theme: string | null;
+  celebration: string | null;
+  items: { title: string; kind: PrintKind; dueDate: string | null; overdue: boolean }[];
+}
+
+export interface MarshaBrief {
+  today: string;
+  printList: (BriefTask & { kind: PrintKind; overdue: boolean })[];
+  designCards: DesignCard[];
+  readiness: BriefReadiness[];
+  isEmpty: boolean;
+}
+
+function addDays(day: string, n: number): string {
+  const d = new Date(`${day}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().slice(0, 10);
+}
+
+/** Build the brief from rows. `today` is the Dubai calendar day (YYYY-MM-DD). */
+export function buildMarshaBrief(today: string, tasks: BriefTask[], readiness: BriefReadiness[]): MarshaBrief {
+  const tomorrow = addDays(today, 1);
+  const open = tasks.filter((t) => t.status !== 'completed');
+
+  const printList = open
+    .filter((t) => t.dueDate !== null && t.dueDate <= tomorrow)
+    .map((t) => ({ ...t, kind: printKind(t.key), overdue: (t.dueDate as string) < today }))
+    .sort((a, b) => (a.dueDate as string).localeCompare(b.dueDate as string) || a.eventDate.localeCompare(b.eventDate));
+
+  const byEvent = new Map<string, DesignCard>();
+  for (const t of open) {
+    let card = byEvent.get(t.eventId);
+    if (!card) {
+      card = { eventId: t.eventId, reference: t.reference, eventDate: t.eventDate, babyName: t.babyName, theme: t.theme, celebration: t.celebration, items: [] };
+      byEvent.set(t.eventId, card);
+    }
+    card.items.push({ title: t.title, kind: printKind(t.key), dueDate: t.dueDate, overdue: t.dueDate !== null && t.dueDate < today });
+  }
+  const designCards = [...byEvent.values()].sort((a, b) => a.eventDate.localeCompare(b.eventDate));
+
+  const ready = readiness
+    .filter((r) => r.openPrep > 0 || r.unassignedPrep > 0 || r.openCrew > 0)
+    .sort((a, b) => a.eventDate.localeCompare(b.eventDate));
+
+  return { today, printList, designCards, readiness: ready, isEmpty: !printList.length && !designCards.length && !ready.length };
+}
+
+const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m] as string));
+
+function prettyDay(day: string | null): string {
+  if (!day) return 'no due date';
+  return new Date(`${day}T00:00:00Z`).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
+}
+
+const KIND_LABEL: Record<PrintKind, string> = { print: 'Print', cricut: 'Cricut cut', design: 'Design' };
+
+/** The English email Marsha receives. */
+export function renderMarshaBriefHtml(b: MarshaBrief): string {
+  const who = (x: { babyName: string | null; reference: string }) => `${esc(x.babyName || 'Party')} · ${esc(x.reference)}`;
+  const theme = (x: { theme: string | null; celebration?: string | null }) =>
+    [x.celebration, x.theme].filter(Boolean).map(esc).join(' · ') || 'Theme not set';
+
+  const printRows = b.printList.length
+    ? b.printList.map((t) => `<tr>
+        <td style="padding:6px 8px;border-bottom:1px solid #EEE"><b>${esc(t.title)}</b><br><span style="color:#8A7F88;font-size:12px">${KIND_LABEL[t.kind]}</span></td>
+        <td style="padding:6px 8px;border-bottom:1px solid #EEE">${who(t)}<br><span style="color:#8A7F88;font-size:12px">${theme(t)} · party ${prettyDay(t.eventDate)}</span></td>
+        <td style="padding:6px 8px;border-bottom:1px solid #EEE;white-space:nowrap;${t.overdue ? 'color:#B3261E;font-weight:700' : ''}">${t.overdue ? 'Late · ' : ''}${prettyDay(t.dueDate)}</td></tr>`).join('')
+    : `<tr><td style="padding:8px;color:#5B8A5B">Nothing due today or tomorrow.</td></tr>`;
+
+  const cards = b.designCards.length
+    ? b.designCards.map((c) => `<div style="border:1px solid #EADCE4;border-radius:12px;padding:10px 12px;margin:0 0 8px">
+        <div style="font-weight:700">${who(c)} — party ${prettyDay(c.eventDate)}</div>
+        <div style="color:#8A7F88;font-size:13px;margin-bottom:4px">${theme(c)}</div>
+        <ul style="margin:0;padding-left:18px">${c.items.map((i) => `<li>${esc(i.title)} <span style="color:#8A7F88">(${KIND_LABEL[i.kind]}, due ${prettyDay(i.dueDate)}${i.overdue ? ', <b style="color:#B3261E">late</b>' : ''})</span></li>`).join('')}</ul></div>`).join('')
+    : `<p style="color:#5B8A5B;margin:0">No open design work in the next 7 days.</p>`;
+
+  const ready = b.readiness.length
+    ? b.readiness.map((r) => {
+        const notes = [
+          r.openPrep ? `${r.openPrep} prep task${r.openPrep > 1 ? 's' : ''} not finished` : '',
+          r.unassignedPrep ? `${r.unassignedPrep} with nobody assigned` : '',
+          r.openCrew ? `${r.openCrew} crew slot${r.openCrew > 1 ? 's' : ''} empty` : '',
+        ].filter(Boolean).join(' · ');
+        return `<li style="margin:0 0 6px"><b>${who(r)}</b> — party ${prettyDay(r.eventDate)}<br><span style="color:#8A7F88">${esc(notes)}</span></li>`;
+      }).join('')
+    : `<li style="color:#5B8A5B">All parties in the next 2 days look ready.</li>`;
+
+  return `<!doctype html><html><body style="margin:0;background:#F7F3F5;font-family:Arial,Helvetica,sans-serif;color:#3B3641">
+  <div style="max-width:640px;margin:0 auto;padding:20px">
+    <div style="background:#fff;border-radius:16px;padding:20px">
+      <h1 style="font-size:20px;margin:0 0 4px">Good morning Marsha 💛</h1>
+      <p style="margin:0 0 16px;color:#8A7F88">Your brief for ${prettyDay(b.today)}. Read-only summary from the prep plan — nothing was changed.</p>
+      <h2 style="font-size:16px;margin:0 0 6px">1. Print &amp; cut list (today / tomorrow)</h2>
+      <table style="width:100%;border-collapse:collapse;font-size:14px;margin-bottom:18px">${printRows}</table>
+      <h2 style="font-size:16px;margin:0 0 6px">2. Design cards (next 7 days)</h2>
+      <div style="font-size:14px;margin-bottom:18px">${cards}</div>
+      <h2 style="font-size:16px;margin:0 0 6px">3. Party readiness (next 2 days)</h2>
+      <ul style="padding-left:18px;margin:0;font-size:14px">${ready}</ul>
+      <p style="margin:18px 0 0;font-size:11px;color:#9B8A94">Automatic morning brief for Marsha. Mark tasks done in the Ops app as usual.</p>
+    </div>
+  </div></body></html>`;
+}
