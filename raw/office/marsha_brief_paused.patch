+/**
+ * Marsha's morning brief — database + scheduling part. See marshaBriefCore.ts.
+ *
+ * Once per Dubai day at/after 08:00 the reconcile sweep calls sweepMarshaBrief():
+ * it claims `marsha_brief:<YYYY-MM-DD>` in app_kv FIRST (atomic insert, so
+ * several instances can never send twice), reads the prep plan READ-ONLY and
+ * emails Marsha one English brief. If there is nothing to report it sends
+ * nothing. It never changes a task and never contacts a customer or supplier.
+ */
+import { pool } from '../db/pool.js';
+import { eventMetaFor } from './prep.js';
+import { buildMarshaBrief, renderMarshaBriefHtml, type BriefReadiness, type BriefTask, type MarshaBrief } from './marshaBriefCore.js';
+
+const MARSHA_EMAIL = 'marsha@eventanauae.com';
+
+function dubaiDay(now = Date.now()): { day: string; hour: number } {
+  const d = new Date(now + 4 * 3_600_000);
+  return { day: d.toISOString().slice(0, 10), hour: d.getUTCHours() };
+}
+
+/** Read the open design work and the 2-day readiness, then build the brief. */
+export async function loadMarshaBrief(today: string): Promise<MarshaBrief> {
+  const tasksQ = await pool.query<{ event_id: string; key: string; title: string; due: string | null; status: string; event_date: string }>(
+    `SELECT pt.event_id, pt.key, pt.title, to_char(pt.due_date,'YYYY-MM-DD') AS due, pt.status,
+            to_char(e.event_date,'YYYY-MM-DD') AS event_date
+       FROM prep_tasks pt
+       JOIN events e ON e.id = pt.event_id
+      WHERE pt.category = 'design' AND pt.status <> 'completed'
+        AND e.phase <> 'Cancelled' AND NOT COALESCE(e.date_tbd, false)
+        AND e.event_date >= $1::date AND e.event_date <= $1::date + 7
+      ORDER BY e.event_date, pt.due_date NULLS LAST, pt.id`,
+    [today],
+  );
+  const readyQ = await pool.query<{ id: string; event_date: string; open_prep: number; unassigned_prep: number; open_crew: number }>(
+    `SELECT e.id, to_char(e.event_date,'YYYY-MM-DD') AS event_date,
+            (SELECT count(*) FROM prep_tasks pt WHERE pt.event_id = e.id AND pt.status <> 'completed')::int AS open_prep,
+            (SELECT count(*) FROM prep_tasks pt WHERE pt.event_id = e.id AND pt.status <> 'completed'
+                AND NOT EXISTS (SELECT 1 FROM prep_task_staff s WHERE s.task_id = pt.id))::int AS unassigned_prep,
+            (SELECT count(*) FROM event_staff es WHERE es.event_id = e.id
+                AND es.assignee_id IS NULL AND COALESCE(es.part_time_name, '') = '')::int AS open_crew
+       FROM events e
+      WHERE e.phase <> 'Cancelled' AND NOT COALESCE(e.date_tbd, false)
+        AND e.event_date >= $1::date AND e.event_date <= $1::date + 2
+      ORDER BY e.event_date`,
+    [today],
+  );
+
+  const meta = await eventMetaFor([...tasksQ.rows.map((r) => r.event_id), ...readyQ.rows.map((r) => r.id)]);
+  const tasks: BriefTask[] = tasksQ.rows.map((r) => {
+    const m = meta.get(r.event_id);
+    return {
+      eventId: r.event_id, reference: m?.reference ?? r.event_id, eventDate: r.event_date,
+      babyName: m?.babyName ?? null, theme: m?.theme ?? null, celebration: m?.celebrationType ?? null,
+      key: r.key, title: r.title, dueDate: r.due, status: r.status,
+    };
+  });
+  const readiness: BriefReadiness[] = readyQ.rows.map((r) => {
+    const m = meta.get(r.id);
+    return {
+      eventId: r.id, reference: m?.reference ?? r.id, eventDate: r.event_date,
+      babyName: m?.babyName ?? null, theme: m?.theme ?? null,
+      openPrep: Number(r.open_prep), unassignedPrep: Number(r.unassigned_prep), openCrew: Number(r.open_crew),
+    };
+  });
+  return buildMarshaBrief(today, tasks, readiness);
+}
+
+let briefRunning = false;
+
+/** Called from the periodic reconcile sweep. Once per Dubai day, at/after 08:00. */
+export async function sweepMarshaBrief(): Promise<void> {
+  if (briefRunning) return;
+  const { day, hour } = dubaiDay();
+  if (hour < 8) return;
+  briefRunning = true;
+  try {
+    const claim = await pool.query(
+      `INSERT INTO app_kv (k, v) VALUES ($1, now()) ON CONFLICT (k) DO NOTHING RETURNING k`, [`marsha_brief:${day}`],
+    );
+    if (!claim.rowCount) return;
+    const brief = await loadMarshaBrief(day);
+    if (brief.isEmpty) { console.log(`[marsha-brief] ${day} nothing to report`); return; }
+    const { emailEnabled, sendEmail } = await import('../integrations/email.js');
+    if (!emailEnabled()) { console.log(`[marsha-brief] ${day} email disabled`); return; }
+    const late = brief.printList.filter((t) => t.overdue).length;
+    const subject = `Eventana — Morning brief ${day}: ${brief.printList.length} to print/cut${late ? ` (${late} late)` : ''}, ${brief.readiness.length} part${brief.readiness.length === 1 ? 'y' : 'ies'} to check`;
+    const res = await sendEmail({ to: MARSHA_EMAIL, subject, html: renderMarshaBriefHtml(brief) });
+    console.log(`[marsha-brief] ${day} print=${brief.printList.length} cards=${brief.designCards.length} readiness=${brief.readiness.length} emailed=${res.ok}`);
+    if (!res.ok) console.error('[marsha-brief] email failed:', res.error);
+  } catch (err) {
+    console.error('[marsha-brief] sweep failed:', (err as Error).message);
+  } finally {
+    briefRunning = false;
+  }
+}
diff --git a/apps/api/src/domain/marshaBriefCore.ts b/apps/api/src/domain/marshaBriefCore.ts
new file mode 100644
